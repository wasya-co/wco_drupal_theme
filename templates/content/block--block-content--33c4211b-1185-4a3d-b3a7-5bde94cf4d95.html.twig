{%
  set classes = [
    'block',
    'block-' ~ configuration.provider|clean_class,
    'block-' ~ plugin_id|clean_class,
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if label %}
    <h2{{ title_attributes }}>{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}
  {% block content %}


<section class="contact-us-2-md">
  <div class="maxwidth">
    {{ content.body }}

    {{ content.field_model_path }}
  </div>
</section>


  {% endblock %}
</div>

